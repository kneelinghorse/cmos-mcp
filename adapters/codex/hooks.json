{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "reasonbook hook session-start --harness codex --hook-source rbook-codex",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "reasonbook hook prompt --harness codex --hook-source rbook-codex",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "reasonbook hook stop --harness codex --hook-source rbook-codex",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "reasonbook hook pre-compact --harness codex --hook-source rbook-codex",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "reasonbook hook session-end --harness codex --hook-source rbook-codex",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
