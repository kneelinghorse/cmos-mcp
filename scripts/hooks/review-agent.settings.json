{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "RBOOK_AGENT_ROLE": "review"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
