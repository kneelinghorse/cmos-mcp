                ],
              },
            },
            "required": [
              "path",
              "value",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "missionId": {
          "description": "Filter next_steps to rows stamped with this mission (#487 mission -> row trail)",
          "type": "string",
        },
        "mode": {
          "description": "Update mode for update action",
          "enum": [
            "aggregate",
            "manual",
          ],
          "type": "string",
        },
        "nextStepAction": {
          "description": "Sub-action for next_steps: list | complete | carry | drop",
          "enum": [
            "list",
            "complete",
            "carry",
            "drop",
          ],
          "type": "string",
        },
        "nextStepIds": {
          "description": "Next-step IDs to act on for complete/carry/drop",
          "items": {
            "type": "number",
          },
          "type": "array",
        },
        "nextStepStatus": {
          "description": "Filter status for next_steps list (default: pending)",
          "enum": [
            "pending",
            "completed",
            "carried",
            "dropped",
          ],
          "type": "string",
        },
        "page": {
          "description": "Page number for history action",
          "minimum": 1,
          "type": "number",
        },
        "pageSize": {
          "description": "Page size for history action",
          "maximum": 100,
          "minimum": 1,
          "type": "number",
        },
        "projectRoot": {
          "description": "Project root directory to search for CMOS database (defaults to cwd)",
          "type": "string",
        },
        "query": {
          "description": "Search query string for search action",
          "type": "string",
        },
        "recencyWeight": {
          "description": "Recency boost weight 0–1 for search action (default: 0.2)",
          "maximum": 1,
          "minimum": 0,
          "type": "number",
        },
        "searchLimit": {
          "description": "Max results for search action (default: 5)",
          "maximum": 50,
