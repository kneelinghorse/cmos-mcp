  {
    "description": "Consolidated mission state-machine tool with action parameter support. Actions: start, complete, block, unblock, drop, defer. Enforces state-machine rules and logs transition events.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Transition action: start | complete | block | unblock | drop | defer",
          "enum": [
            "start",
            "complete",
            "block",
            "unblock",
            "drop",
            "defer",
          ],
          "type": "string",
        },
        "agentFeedback": {
          "description": "Optional free-text UX feedback (Sprint 56 m03). Use on complete actions to flag rough edges or improvement ideas you hit while working the mission. Reviewed via cmos_feedback(action="list").",
          "maxLength": 2000,
          "type": "string",
        },
        "blockers": {
          "description": "List of blockers for block action",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "decisions": {
          "description": "Decisions made during mission for complete action",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "deferUntil": {
          "description": "Hint about when to re-queue for defer action (e.g., "after sprint 48")",
          "type": "string",
        },
        "missionId": {
          "description": "The mission ID to transition",
          "type": "string",
        },
        "notes": {
          "description": "Notes for start/complete actions",
          "type": "string",
        },
        "projectRoot": {
          "description": "Project root directory to search for CMOS database (defaults to cwd)",
          "type": "string",
        },
        "reason": {
          "description": "Reason for block/drop/defer actions (required for block)",
          "type": "string",
        },
        "resolution": {
          "description": "Resolution notes for unblock action",
          "type": "string",
        },
        "targetStatus": {
          "description": "Target status after unblock (default: In Progress)",
          "enum": [
            "In Progress",
            "Current",
          ],
          "type": "string",
        },
      },
      "required": [
        "action",
        "missionId",
      ],
      "type": "object",
    },
    "name": "cmos_mission_transition",
  },
  {
    "description": "Consolidated project tool with action parameter support. Actions: init, register, list, unregister, validate, prune, update, sweep. The list action supports an optional validate flag. The prune action removes registry entries where the local CMOS database no longer exists on disk. The update action allows setting project_type (general/managed/build). The sweep action returns all open missions and active sessions across registered instances.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Project action: init | register | list | unregister | validate | prune | update | sweep",
          "enum": [
            "init",
            "register",
            "list",
            "unregister",
            "validate",
            "prune",
            "update",
            "sweep",
          ],
          "type": "string",
        },
        "initialMissions": {
          "description": "Initial missions for init action",
          "items": {
            "type": "object",
          },
          "type": "array",
        },
        "initialSprint": {
          "description": "Initial sprint config for init action",
          "type": "object",
        },
        "instances": {
          "description": "Restrict sweep to these registry names only",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "itemType": {
          "description": "Restrict sweep to missions or sessions only",
          "enum": [
            "mission",
            "session",
          ],
          "type": "string",
        },
        "name": {
          "description": "Display name for register action",
          "type": "string",
        },
        "projectId": {
          "description": "Project ID for init action",
          "type": "string",
        },
        "projectName": {
          "description": "Project name for init action",
          "type": "string",
        },
        "projectRoot": {
          "description": "Project root directory",
          "type": "string",
        },
        "projectType": {
          "description": "Project type/tier for the init and update actions (defaults to build for new projects)",
          "enum": [
            "general",
            "managed",
            "build",
          ],
          "type": "string",
        },
        "prune": {
          "description": "Prune invalid entries for validate action",
          "type": "boolean",
        },
        "setAsDefault": {
          "description": "Set as default project for register action",
          "type": "boolean",
        },
        "statusFilter": {
          "description": "Restrict sweep to these mission/session statuses",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "tracelabProjectId": {
          "description": "TraceLab project ID for init action",
          "type": "string",
        },
        "validate": {
          "description": "Run validation on list action (routes to validate handler)",
          "type": "boolean",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "cmos_project",
  },
  {
    "description": "Bundled session-opener digest (≤4KB). Replaces the older three-step opener (cmos_agent_onboard + cmos_context(action="view") + cmos_mission(action="status")) with one payload. Top-3 next_actions are promoted to a flat top-level field. Includes an always-on cross-store \`portfolio\` rollup (active missions across your registered projects) built on the graph-backed queryAcrossStores; it degrades to null for a single-project setup.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "projectRoot": {
          "description": "Project root directory to search for CMOS database (defaults to cwd)",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "cmos_review",
  },
  {
    "description": "Consolidated session tool with action parameter support. Actions: list, start, capture, complete, search. Routes to the existing session handlers without changing session business logic.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Session action: list | start | capture | complete | search",
          "enum": [
            "list",
            "start",
            "capture",
            "complete",
            "search",
          ],
          "type": "string",
        },
        "agent": {
          "description": "Agent identifier for start/capture/complete actions",
          "type": "string",
        },
        "autoRefreshMasterContext": {
          "description": "Auto-refresh master context on start",
          "type": "boolean",
        },
        "category": {
          "description": "Capture category for capture action",
          "enum": [
            "decision",
            "learning",
            "constraint",
            "context",
            "next-step",
          ],
          "type": "string",
        },
        "citesLearningIds": {
          "description": "Learning IDs this capture/decision cites. Bumps last_reviewed_at on each — applies to capture(category=decision|learning) and complete(decisions[]).",
          "items": {
            "minimum": 1,
            "type": "integer",
          },
          "type": "array",
        },
        "content": {
          "description": "Capture content for capture action",
          "type": "string",
        },
        "context": {
          "description": "Additional context for capture action",
          "type": "string",
        },
        "decisions": {
          "description": "Decisions captured at session close; each entry is inserted into strategic_decisions",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "evidence": {
          "description": "Array of TraceLab evidence references [{type, id}] for decision captures",
          "items": {
            "properties": {
              "id": {
                "description": "Evidence identifier",
                "type": "string",
              },
              "type": {
                "description": "Evidence type",
                "type": "string",
              },
            },
            "required": [
              "type",
              "id",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "limit": {
          "description": "Maximum sessions to return for search action (1-100, default: 20)",
          "maximum": 100,
          "minimum": 1,
          "type": "number",
        },
        "missionId": {
          "description": "Associated mission ID. On capture, stamps the decision/learning/next-step row; on complete, stamps the decisions[] and nextSteps[] rows this call materializes.",
          "type": "string",
        },
        "nextSteps": {
          "description": "Next steps for complete action",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "page": {
          "description": "Page number for list action",
          "minimum": 1,
          "type": "number",
        },
        "pageSize": {
          "description": "Page size for list action",
          "maximum": 100,
          "minimum": 1,
          "type": "number",
        },
        "projectRoot": {
          "description": "Project root directory to search for CMOS database (defaults to cwd)",
          "type": "string",
        },
        "query": {
          "description": "Search query for search action (keywords across titles, summaries, captures)",
          "type": "string",
        },
        "sessionId": {
          "description": "Session ID for capture/complete actions",
          "type": "string",
        },
        "since": {
          "description": "Filter sessions started after this ISO date (search action)",
          "type": "string",
        },
        "sprintId": {
          "description": "Sprint ID filter for list action",
          "type": "string",
        },
        "status": {
          "description": "Filter by session status for list action",
          "enum": [
            "active",
            "completed",
            "canceled",
          ],
          "type": "string",
        },
        "summary": {
          "description": "Session summary for complete action",
          "type": "string",
        },
        "title": {
          "description": "Session title for start action",
          "type": "string",
        },
        "type": {
          "description": "Session type for list/start actions",
          "enum": [
            "onboarding",
            "planning",
            "review",
            "research",
            "check-in",
            "custom",
          ],
          "type": "string",
        },
        "until": {
          "description": "Filter sessions started before this ISO date (search action)",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "cmos_session",
  },
  {
    "description": "Consolidated sprint tool with action parameter support. Actions: list, show, add, update, complete, retro, carry_forward, analytics. Use retro to auto-generate a sprint retrospective report with KPIs, decisions, learnings, and git commit summary. Use carry_forward to detect sync gaps and blocked missions and send backlog_request messages to a target project. Use analytics to compute cross-sprint trend KPIs: velocity, completion rate, decision volume, cycle time.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Sprint action: list | show | add | update | complete",
          "enum": [
            "list",
            "show",
            "add",
            "update",
            "complete",
            "retro",
            "carry_forward",
            "analytics",
          ],
          "type": "string",
        },
        "condensation": {
          "description": "Optional condensation strategy for complete action",
          "enum": [
            "none",
            "conservative",
            "auto",
            "aggressive",
          ],
          "type": "string",
        },
        "endDate": {
          "description": "Sprint end date for add action",
          "type": "string",
        },
        "fields": {
          "additionalProperties": false,
          "description": "Fields payload for update action",
          "properties": {
            "endDate": {
              "description": "End date in ISO format (e.g., "2025-01-15")",
              "type": "string",
            },
            "focus": {
              "description": "Strategic focus or theme of the sprint",
              "type": "string",
            },
            "startDate": {
              "description": "Start date in ISO format (e.g., "2025-01-01")",
              "type": "string",
            },
            "status": {
              "description": "Sprint status (e.g., "Active", "Completed")",
              "type": "string",
            },
            "title": {
              "description": "Sprint title",
              "type": "string",
            },
          },
          "type": "object",
        },
        "focus": {
          "description": "Strategic focus or theme for add action",
          "type": "string",
        },
        "forceComplete": {
          "description": "No-op for complete action, kept for backward compatibility. Build-freshness is advisory — staleness is surfaced as a warning and never blocks closeout.",
          "type": "boolean",
        },
        "limit": {
          "description": "Maximum sprints to return for list action",
          "maximum": 100,
          "minimum": 1,
          "type": "number",
        },
        "projectRoot": {
          "description": "Project root directory to search for CMOS database (defaults to cwd)",
          "type": "string",
        },
        "send": {
          "description": "Whether to actually send messages for carry_forward (default true, false = dry run)",
          "type": "boolean",
        },
        "sprintId": {
          "description": "Sprint ID for show/add/update/complete actions",
          "type": "string",
        },
        "startDate": {
          "description": "Sprint start date for add action",
          "type": "string",
        },
        "status": {
          "description": "Filter or sprint status depending on action",
          "type": "string",
        },
        "summary": {
          "description": "Closeout summary for complete action",
          "type": "string",
        },
        "targetAddress": {
          "description": "cmos:// address for carry_forward action (e.g., cmos://derek/cmos-dashboard)",
          "type": "string",
        },
        "targetSizePercent": {
          "description": "Target size percent for complete action condensation",
          "maximum": 100,
          "minimum": 1,
          "type": "number",
        },
        "title": {
          "description": "Sprint title for add action",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "cmos_sprint",
  },
  {
    "description": "Return a structured status payload for the current project: cmos_address, dashboard_url, auth_tier, last_sync_at, last_delivery_observed_at. Mirrors onboard.authState.authTier on the auth_tier field for cross-side parity with the dashboard. Useful for support/ops triage and at-a-glance health.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "projectRoot": {
          "description": "Project root directory to search for CMOS database (defaults to cwd)",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "cmos_status",
  },
