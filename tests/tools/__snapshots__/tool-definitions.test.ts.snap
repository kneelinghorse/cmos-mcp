          "type": "boolean",
        },
        "evergreen": {
          "description": "s84-m05: on reaffirm, set/clear the durable evergreen flag (true = never trip staleness review/count, for institutional rules). Omit to leave unchanged.",
          "type": "boolean",
        },
        "fieldUpdates": {
          "description": "Field-level updates for update action. Each entry must have "path" (dot-notation field name) and "value". Example: [{path: "project_name", value: "My Project"}, {path: "type_fields.stack", value: "Node.js"}]",
          "items": {
