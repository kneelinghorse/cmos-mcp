          "type": "array",
        },
        "sessionId": {
          "description": "Session ID for snapshot/history actions",
          "type": "string",
        },
        "since": {
          "description": "ISO date filter for update/history actions",
          "type": "string",
        },
        "sizeOnly": {
          "description": "Return only size info for view action",
          "type": "boolean",
        },
        "source": {
          "description": "Snapshot source label for snapshot action",
          "type": "string",
        },
