          "description": "Target sprint ID for carry action",
          "type": "string",
        },
        "compact": {
          "description": "Return compact view for view action",
          "type": "boolean",
        },
        "constraintAction": {
          "description": "Sub-action for constraints: list | review | archive | reaffirm",
          "enum": [
            "list",
