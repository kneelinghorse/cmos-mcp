{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "research.tracelab-deepsearch Domain Fields",
  "description": "DeepSearch research mission schema for automated research execution",
  "type": "object",
  "required": ["mission_id", "title", "objective", "success_criteria"],
  "properties": {
    "type": {
      "type": "string",
      "const": "research.tracelab-deepsearch",
      "description": "Domain pack type identifier"
    },
    "mission_id": {
      "type": "string",
      "description": "Unique mission identifier (e.g., DRM.0.7)"
    },
    "title": {
      "type": "string",
      "maxLength": 255,
      "description": "Human-readable title (3-255 chars recommended)"
    },
    "objective": {
      "type": "string",
      "description": "Primary research question"
    },
    "success_criteria": {
      "type": "array",
      "description": "Research objectives - each becomes an objective the agent tries to satisfy. Must be web-searchable, not self-referential.",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object",
      "description": "Optional context fields to enhance quality",
      "properties": {
        "background": {
          "type": "string",
          "description": "Domain context, why this matters"
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Scope boundaries, limitations"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Related missions"
        }
      }
    },
    "research_phases": {
      "type": "object",
      "description": "Structured research plan with named phases",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Phase title"
          },
          "tasks": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tasks to complete in this phase"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "description": "Expected output artifacts",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "description": "DeepSearch execution metadata",
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Categorization tags"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"],
          "default": "normal",
          "description": "Mission priority level"
        },
        "max_loops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Research iterations (1-10)"
        }
      }
    }
  }
}
