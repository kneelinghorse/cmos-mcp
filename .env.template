# CMOS-MCP Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# Project root directory - REQUIRED for CMOS MCP tools to locate the database
CMOS_PROJECT_ROOT=/path/to/your/cmos-mcp

# CMOS configuration
CMOS_AUTO_SNAPSHOT=1
CMOS_SNAPSHOT_RETENTION_DAYS=7
CMOS_MAX_SNAPSHOTS=50

# Dashboard integration
CMOS_DASHBOARD_URL=https://cmos.aquex.ai
CMOS_DASHBOARD_USER=
CMOS_DASHBOARD_PASSWORD=

# Development environment
NODE_ENV=development
DEBUG=true
DB_PATH=cmos/db/cmos.sqlite
