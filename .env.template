# Reasonbook Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# Project root directory - REQUIRED for Reasonbook MCP tools to locate the database
RBOOK_PROJECT_ROOT=/path/to/your/rbook

# Reasonbook configuration
RBOOK_AUTO_SNAPSHOT=1
RBOOK_SNAPSHOT_RETENTION_DAYS=7
RBOOK_MAX_SNAPSHOTS=50

# Dashboard integration
RBOOK_DASHBOARD_URL=https://reasonbook.ai
RBOOK_DASHBOARD_USER=
RBOOK_DASHBOARD_PASSWORD=

# Development environment
NODE_ENV=development
DEBUG=true
DB_PATH=rbook/db/rbook.sqlite
